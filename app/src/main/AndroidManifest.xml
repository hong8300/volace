<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Timed profiles (DESIGN.md 5.14): a foreground service from start to end, so the volume
         may be changed back from the background on Android 17; an exact alarm for the end;
         the notification showing it; picking it up again after a reboot. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:localeConfig="@xml/locales_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Volace">

        <!-- singleTask: however it is opened (launcher, widget, tile), the one existing instance
             comes back with its state, e.g. a half-done edit, instead of a fresh copy on top. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Volace">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receives every widget tap; applies the profile and redraws all widgets. -->
        <receiver
            android:name=".widget.VolumeApplyReceiver"
            android:exported="false" />

        <!-- Quick Settings tile; tapping it opens ProfilePickerActivity. -->
        <service
            android:name=".tile.ProfileTileService"
            android:exported="true"
            android:icon="@drawable/ic_profile_volume_up"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Target of the launcher shortcuts: applies one profile and closes. -->
        <activity
            android:name=".shortcut.ApplyShortcutActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Volace.Picker" />

        <!-- Opened by the tile over whatever is on screen: its own task, kept out of Recents. -->
        <activity
            android:name=".tile.ProfilePickerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Volace.Picker" />

        <!-- Timed profiles: the service that runs until the end, the alarm / notification actions,
             and "今すぐ戻す" from a notification (a visible activity may always change volumes). -->
        <service
            android:name=".timer.TimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Restores the user's volume settings at the time they chose. Android 17 only lets a foreground service started while the app was visible change volumes from the background." />
        </service>

        <receiver
            android:name=".timer.TimerReceiver"
            android:exported="false" />

        <receiver
            android:name=".timer.TimerBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".timer.TimerActionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Volace.Picker" />

        <!-- Redraws the widgets when the volume is changed outside Volace (keys, system panel). -->
        <service
            android:name=".widget.VolumeWatchJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".widget.Volace1x1Provider"
            android:exported="false"
            android:label="@string/widget_label_1x1">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_1x1" />
        </receiver>

        <receiver
            android:name=".widget.Volace1x4Provider"
            android:exported="false"
            android:label="@string/widget_label_1x4">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_1x4" />
        </receiver>

        <receiver
            android:name=".widget.Volace2x4Provider"
            android:exported="false"
            android:label="@string/widget_label_2x4">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_2x4" />
        </receiver>
    </application>

</manifest>
