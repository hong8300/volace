<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Per-profile default sounds (DESIGN.md 5.16): "システム設定の変更", granted by the user in Settings. -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Timed profiles and the schedule (DESIGN.md 5.14, 5.15): Android 17 only lets an app change
         volumes from the background while a foreground service runs (8.7), which an exact alarm
         may start; the notifications showing them; picking them up again after a reboot. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:localeConfig="@xml/locales_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Volace">

        <!-- singleTask: however it is opened (launcher, widget, tile), the one existing instance
             comes back with its state, e.g. a half-done edit, instead of a fresh copy on top. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Volace">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receives every widget tap; applies the profile and redraws all widgets. -->
        <receiver
            android:name=".widget.VolumeApplyReceiver"
            android:exported="false" />

        <!-- Quick Settings tile; tapping it opens ProfilePickerActivity. -->
        <service
            android:name=".tile.ProfileTileService"
            android:exported="true"
            android:icon="@drawable/ic_profile_volume_up"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Target of the launcher shortcuts: applies one profile and closes. -->
        <activity
            android:name=".shortcut.ApplyShortcutActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Volace.Picker" />

        <!-- Opened by the tile over whatever is on screen: its own task, kept out of Recents. -->
        <activity
            android:name=".tile.ProfilePickerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Volace.Picker" />

        <!-- Timed profiles: the service that runs until the end, the alarm / notification actions,
             and "今すぐ戻す" from a notification (a visible activity may always change volumes). -->
        <service
            android:name=".timer.TimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows the timed volume profile the user started and switches back at the time they chose. Android 17 only lets an app change volumes from the background while a foreground service runs." />
        </service>

        <receiver
            android:name=".timer.TimerReceiver"
            android:exported="false" />

        <receiver
            android:name=".timer.TimerBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".timer.TimerActionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Volace.Picker" />

        <!-- The schedule: the service that switches at a boundary (for a second), the alarm, picking
             the alarm up again (reboot, update, clock or time-zone change), and "tap to switch"
             from the notification when Android ignored the switch. -->
        <service
            android:name=".schedule.ScheduleService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Switches to the volume profile the user scheduled for this time. Android 17 only lets an app change volumes from the background while a foreground service runs." />
        </service>

        <receiver
            android:name=".schedule.ScheduleReceiver"
            android:exported="false" />

        <receiver
            android:name=".schedule.ScheduleBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".schedule.ScheduleActionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Volace.Picker" />

        <!-- Redraws the widgets when the volume is changed outside Volace (keys, system panel). -->
        <service
            android:name=".widget.VolumeWatchJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".widget.Volace1x1Provider"
            android:exported="false"
            android:label="@string/widget_label_1x1">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_1x1" />
        </receiver>

        <receiver
            android:name=".widget.Volace1x4Provider"
            android:exported="false"
            android:label="@string/widget_label_1x4">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_1x4" />
        </receiver>

        <receiver
            android:name=".widget.Volace2x4Provider"
            android:exported="false"
            android:label="@string/widget_label_2x4">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_2x4" />
        </receiver>
    </application>

</manifest>
