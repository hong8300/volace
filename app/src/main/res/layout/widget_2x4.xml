<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:clipToOutline="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_root_bg"
    android:padding="2dp">

    <!-- Live read-out of the device's volumes (stat_0..5 in VolumeStream order); tapping it
         opens the app. Hidden by WidgetRenderer when the widget is too short to fit it. -->
    <LinearLayout
        android:id="@+id/status_panel"
        android:foreground="@drawable/widget_press"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="3dp"
        android:orientation="vertical"
        android:background="@drawable/widget_status_bg"
        android:paddingLeft="12dp"
        android:paddingRight="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="7dp">

        <LinearLayout
