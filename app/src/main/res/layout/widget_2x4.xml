                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:text="@string/current_volume" />

            <TextView
                android:id="@+id/status_open"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FF8FB8FF"
                android:textSize="11sp"
                android:text="@string/widget_open_app" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/status_mode_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_profile_volume_up"
                android:tint="#FFDCDCE6"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/status_mode_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingLeft="5dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFDCDCE6"
                android:textSize="11sp"
                android:text="@string/ringer_normal" />
        </LinearLayout>

