                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_bar_fill_h"
                        android:tint="#FF8FB8FF"
                        android:contentDescription="@null" />
                </FrameLayout>

                <TextView
