                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:maxLines="1"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#FFDCDCE6"
                    android:textSize="10sp"
                    android:text="5" />
