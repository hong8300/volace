                android:maxLines="1"
                android:ellipsize="end"
                android:paddingTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:text="@string/preview_profile_7" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/cell_7"
        android:foreground="@drawable/widget_press"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="3dp">

        <ImageView
            android:id="@+id/cell_7_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_cell_fill"
            android:tint="#FF5C6BC0"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/cell_7_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_cell_ring"
            android:visibility="gone"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingLeft="2dp"
            android:paddingRight="2dp">

            <ImageView
                android:id="@+id/cell_7_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_profile_bell"
                android:tint="#FFFFFFFF"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/cell_7_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:text="@string/preview_profile_8" />
        </LinearLayout>
    </FrameLayout>
    </LinearLayout>
</LinearLayout>
