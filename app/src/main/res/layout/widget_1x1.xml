<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_root_bg"
    android:padding="2dp">

    <FrameLayout
        android:id="@+id/cell_0"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="3dp">

        <ImageView
            android:id="@+id/cell_0_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_cell_fill"
            android:tint="#FF2196F3"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/cell_0_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_cell_ring"
            android:visibility="gone"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingLeft="2dp"
            android:paddingRight="2dp">

            <ImageView
                android:id="@+id/cell_0_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_profile_volume_up"
                android:tint="#FFFFFFFF"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/cell_0_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:text="通常" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
