<?xml version="1.0" encoding="utf-8"?>
<!-- The 1×1 widget once widened: the cycling cell plus a "選ぶ" tile that opens the chooser, so a
     profile can be picked directly instead of stepping through (and applying) the ones between. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_root_bg"
    android:padding="2dp">

    <FrameLayout
        android:id="@+id/cell_0"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="3dp">

        <ImageView
            android:id="@+id/cell_0_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_cell_fill"
            android:tint="#FF2196F3"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/cell_0_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_cell_ring"
            android:visibility="gone"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingLeft="2dp"
            android:paddingRight="2dp">

            <ImageView
                android:id="@+id/cell_0_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_profile_volume_up"
                android:tint="#FFFFFFFF"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/cell_0_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:text="通常" />

            <TextView
                android:id="@+id/cycle_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingTop="1dp"
                android:textColor="#CCFFFFFF"
                android:textSize="9sp"
                android:text="タップで次へ" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/pick_button"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="3dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_status_bg">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_widget_list"
            android:tint="#FFDCDCE6"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:text="選ぶ" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#CCDCDCE6"
            android:textSize="9sp"
            android:text="一覧から" />
    </LinearLayout>
</LinearLayout>
