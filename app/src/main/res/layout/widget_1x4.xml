<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_root_bg"
    android:padding="2dp">

    <FrameLayout
        android:id="@+id/cell_0"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="3dp">

        <ImageView
            android:id="@+id/cell_0_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_cell_fill"
            android:tint="#FF2196F3"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/cell_0_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_cell_ring"
            android:visibility="gone"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingLeft="2dp"
            android:paddingRight="2dp">

            <ImageView
                android:id="@+id/cell_0_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_profile_volume_up"
                android:tint="#FFFFFFFF"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/cell_0_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:text="通常" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/cell_1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="3dp">

        <ImageView
            android:id="@+id/cell_1_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_cell_fill"
            android:tint="#FF7E57C2"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/cell_1_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_cell_ring"
            android:visibility="gone"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingLeft="2dp"
            android:paddingRight="2dp">

            <ImageView
                android:id="@+id/cell_1_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_profile_night"
                android:tint="#FFFFFFFF"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/cell_1_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:text="就寝" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/cell_2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="3dp">

        <ImageView
            android:id="@+id/cell_2_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_cell_fill"
            android:tint="#FF26A69A"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/cell_2_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_cell_ring"
            android:visibility="gone"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingLeft="2dp"
            android:paddingRight="2dp">

            <ImageView
                android:id="@+id/cell_2_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_profile_music"
                android:tint="#FFFFFFFF"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/cell_2_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:text="音楽" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/cell_3"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="3dp">

        <ImageView
            android:id="@+id/cell_3_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_cell_fill"
            android:tint="#FFFF9800"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/cell_3_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/widget_cell_ring"
            android:visibility="gone"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingLeft="2dp"
            android:paddingRight="2dp">

            <ImageView
                android:id="@+id/cell_3_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_profile_work"
                android:tint="#FFFFFFFF"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/cell_3_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:text="仕事" />
        </LinearLayout>
    </FrameLayout>

    <!-- Live read-out of the device's volumes (stat_0..5 in VolumeStream order); tapping it
         opens the app. -->
    <LinearLayout
        android:id="@+id/status_panel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="3dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/widget_status_bg"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:paddingTop="9dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/status_mode_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_profile_volume_up"
            android:tint="#FFDCDCE6"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="5dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <FrameLayout
                    android:layout_width="4dp"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_bar_track"
                        android:contentDescription="@null" />

                    <ImageView
                        android:id="@+id/stat_0_fill"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_bar_fill_v"
                        android:tint="#FF8FB8FF"
                        android:contentDescription="@null" />
                </FrameLayout>

                <TextView
                    android:id="@+id/stat_0_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="2dp"
                    android:textColor="#B3DCDCE6"
                    android:textSize="8sp"
                    android:text="R" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <FrameLayout
                    android:layout_width="4dp"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_bar_track"
                        android:contentDescription="@null" />

                    <ImageView
                        android:id="@+id/stat_1_fill"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_bar_fill_v"
                        android:tint="#FF8FB8FF"
                        android:contentDescription="@null" />
                </FrameLayout>

                <TextView
                    android:id="@+id/stat_1_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="2dp"
                    android:textColor="#B3DCDCE6"
                    android:textSize="8sp"
                    android:text="N" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <FrameLayout
                    android:layout_width="4dp"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_bar_track"
                        android:contentDescription="@null" />

                    <ImageView
                        android:id="@+id/stat_2_fill"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_bar_fill_v"
                        android:tint="#FF8FB8FF"
                        android:contentDescription="@null" />
                </FrameLayout>

                <TextView
                    android:id="@+id/stat_2_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="2dp"
                    android:textColor="#B3DCDCE6"
                    android:textSize="8sp"
                    android:text="M" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <FrameLayout
                    android:layout_width="4dp"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_bar_track"
                        android:contentDescription="@null" />

                    <ImageView
                        android:id="@+id/stat_3_fill"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_bar_fill_v"
                        android:tint="#FF8FB8FF"
                        android:contentDescription="@null" />
                </FrameLayout>

                <TextView
                    android:id="@+id/stat_3_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="2dp"
                    android:textColor="#B3DCDCE6"
                    android:textSize="8sp"
                    android:text="A" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <FrameLayout
                    android:layout_width="4dp"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_bar_track"
                        android:contentDescription="@null" />

                    <ImageView
                        android:id="@+id/stat_4_fill"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_bar_fill_v"
                        android:tint="#FF8FB8FF"
                        android:contentDescription="@null" />
                </FrameLayout>

                <TextView
                    android:id="@+id/stat_4_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="2dp"
                    android:textColor="#B3DCDCE6"
                    android:textSize="8sp"
                    android:text="V" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <FrameLayout
                    android:layout_width="4dp"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_bar_track"
                        android:contentDescription="@null" />

                    <ImageView
                        android:id="@+id/stat_5_fill"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_bar_fill_v"
                        android:tint="#FF8FB8FF"
                        android:contentDescription="@null" />
                </FrameLayout>

                <TextView
                    android:id="@+id/stat_5_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="2dp"
                    android:textColor="#B3DCDCE6"
                    android:textSize="8sp"
                    android:text="S" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/status_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="3dp"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFDCDCE6"
            android:textSize="10sp"
            android:text="音量詳細" />
    </LinearLayout>
</LinearLayout>
